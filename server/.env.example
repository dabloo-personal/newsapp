PORT=5001

# --- Database -------------------------------------------------------------
# Leave empty to run WITHOUT MongoDB: the app starts an embedded database and fills it with sample
# content. Data is temporary (lost on restart) unless EMBEDDED_DB_PATH points at a persistent disk.
# When you get a connection string (e.g. MongoDB Atlas), put it here and redeploy.
MONGODB_URI=
# EMBEDDED_DB_PATH=/var/data/navbharat
# Seed sample content when the database has no categories. Default: on for the embedded DB, off for MONGODB_URI.
# AUTO_SEED=true

# --- Auth -----------------------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production once MONGODB_URI is set. Without it, a random one is used (logins end on restart).
JWT_SECRET=
JWT_EXPIRES_IN=7d

CLIENT_ORIGIN=http://localhost:5173

# First admin account, created when the database is seeded. In production, leave ADMIN_PASSWORD empty
# to get a random password printed once in the server log — or set your own.
ADMIN_EMAIL=admin@navbharat.local
ADMIN_PASSWORD=Admin@12345
