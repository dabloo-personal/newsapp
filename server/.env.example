PORT=5001

# --- Database (required) --------------------------------------------------
# Your MongoDB connection string, e.g. MongoDB Atlas:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/navbharat24x7?retryWrites=true&w=majority
# or a local server: mongodb://127.0.0.1:27017/navbharat24x7
MONGODB_URI=
# Optional (local demos only): fill an EMPTY database with the fictional sample stories on start.
# Do not enable this for a real site (use `npm run setup` instead, see README).
# AUTO_SEED=true

# --- Auth -----------------------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required when NODE_ENV=production.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Website address(es) allowed to call the API from a browser, comma-separated
# (only needed when the site is on a different domain, e.g. Netlify). Example:
# CLIENT_ORIGIN=https://your-site.netlify.app
CLIENT_ORIGIN=http://localhost:5173

# --- First admin account (created by `npm run setup` / `npm run seed`) ------
ADMIN_EMAIL=admin@navbharat.local
# Production: choose a strong password (min. 8 characters). If empty, a random one is printed once.
ADMIN_PASSWORD=Admin@12345
# LOCAL ONLY: allow logging in as ID "admin" with a short password (e.g. ADMIN_PASSWORD=admin).
# Ignored when NODE_ENV=production. Never set this on a deployed site.
# DEV_SIMPLE_ADMIN=true
